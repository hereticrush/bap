# ──────────────────────────────────────────────
# bap — Environment Configuration Template
# Copy to .env and fill in real values.
# ──────────────────────────────────────────────

# AI Video Provider
ACTIVE_AI_PROVIDER=RUNWAY
RUNWAY_API_KEY=your-key-here

# AI Prompt Builder
ACTIVE_PROMPT_BUILDER=GEMINI
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Cloud Storage (S3 / Cloudflare R2)
S3_BUCKET=your-bucket
S3_REGION=auto
S3_ACCESS_KEY=your-key-here
S3_SECRET_KEY=your-key-here

# YouTube OAuth
YOUTUBE_CLIENT_ID=your-id-here
YOUTUBE_CLIENT_SECRET=your-secret-here

# ElevenLabs
ELEVENLABS_API_KEY=your-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here

# Pipeline: default image anchors when seed metadata omits use_image_anchor (true/false)
ENABLE_IMAGE_ANCHORS=true

# Redis (used by Asynq task queue)
REDIS_URL=redis://localhost:6379

# Health Check Server
HEALTH_PORT=8081

# Crawler Configuration
CRAWLER_FEED_URLS=https://feeds.nasa.gov/ur/limit_files/rss_topstory.xml,https://thedecisionlab.com/feed/,https://techcrunch.com/feed/
CRAWLER_INTERVAL_SECONDS=3600
CRAWLER_GEMINI_MODEL=gemini-2.5-flash

